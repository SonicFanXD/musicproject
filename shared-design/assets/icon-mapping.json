      "size": 24,
      "description": "Siguiente"
    },
    "backward.fill": {
      "android": "ic_skip_previous",
      "size": 24,
      "description": "Anterior"
    },
    "shuffle": {
      "android": "ic_shuffle",
      "size": 20,
      "description": "Aleatorio"
    },
    "repeat": {
      "android": "ic_repeat",
      "size": 20,
      "description": "Repetir"
    },
    "repeat.1": {
      "android": "ic_repeat_one",
      "size": 20,
      "description": "Repetir una"
