{
  "version": "1.0.0",
  "description": "Mapeo de iconos entre iOS SF Symbols y Android Material Icons",
  
  "icon_mapping": {
    "play.fill": {
      "android": "ic_play_arrow",
      "size": 24,
      "description": "Reproducir"
    },
    "pause.fill": {
