<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Audio Permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Bluetooth for audio devices -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- WiFi for Cast -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service for audio playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Wake lock to keep screen on during playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".AuroraPlayerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuroraPlayer"
        tools:targetApi="34">

        <activity
            android:name=".views.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AuroraPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".views.NowPlayingActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraPlayer"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".views.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraPlayer"
            android:parentActivityName=".views.MainActivity" />

        <activity
            android:name=".views.EqualizerActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraPlayer"
            android:parentActivityName=".views.SettingsActivity" />

        <activity
            android:name=".views.LyricsActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraPlayer"
            android:parentActivityName=".views.NowPlayingActivity" />

        <activity
            android:name=".views.LogsActivity"
            android:exported="false"
            android:theme="@style/Theme.AuroraPlayer"
            android:parentActivityName=".views.SettingsActivity" />

        <!-- Cast Media Router -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.aurora.player.services.CastOptionsProvider" />

        <!-- ExoPlayer Audio Service -->
        <service
            android:name=".services.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>